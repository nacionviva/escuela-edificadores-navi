{
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)\\.html", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/plataforma", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ],
  "redirects": [
    { "source": "/", "destination": "/home.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/inscripcion", "destination": "/inscripcion.html" },
    { "source": "/plataforma", "destination": "/index.html" },
    { "source": "/aviso-privacidad", "destination": "/aviso-privacidad.html" },
    { "source": "/congreso", "destination": "/congreso.html" }
  ]
}
